# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库（必须 PostgreSQL）
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/integration

# JWT（与前端字段 accessToken / refreshToken 对齐）
JWT_SECRET=integration-platform-jwt-secret-2024
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

# 敏感字段加密（AES-256-CBC，格式 iv:ciphertext）
ENCRYPTION_KEY=integration-platform-secret-key-2024

# CORS（前端 Next.js 开发地址）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5004,http://127.0.0.1:5004

# 控制台 API 基址（推荐显式带版本号 /api/v1；后端 /api/v1/ 与 /api/ 等价，保留旧路径兼容存量调用方）
# 在 Next 控制台侧设置：NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# 队列：memory（开发） / celery（生产，需 REDIS_URL）
QUEUE_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0
# celery -A executions.queue.celery_app worker -l info

# 运行环境隔离：dev / staging / prod（请求头 X-Environment 可覆盖）
ENVIRONMENT=dev
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 集成商自助开户（沙箱 Key）。生产可关，或设邀请码。
OPEN_REGISTER_ENABLED=true
# OPEN_REGISTER_INVITE=
OPEN_SANDBOX_CALL_QUOTA=10000
OPEN_SANDBOX_ROW_QUOTA=100000
# NEXT_PUBLIC_ENVIRONMENT=dev

# 任务失败邮件告警（不配则只走 Webhook）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
