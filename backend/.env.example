# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库（必须 PostgreSQL）
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/integration

# JWT（与前端字段 accessToken / refreshToken 对齐）
JWT_SECRET=integration-platform-jwt-secret-2024
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

# 敏感字段加密（AES-256-CBC，格式 iv:ciphertext）
ENCRYPTION_KEY=integration-platform-secret-key-2024

# CORS（前端 Next.js 开发地址）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5004,http://127.0.0.1:5004

# 控制台 API 基址（推荐显式带版本号 /api/v1；后端 /api/v1/ 与 /api/ 等价，保留旧路径兼容存量调用方）
# 在 Next 控制台侧设置：NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1

# 队列：memory（开发） / celery（生产，需 REDIS_URL）
QUEUE_BACKEND=memory
# REDIS_URL=redis://127.0.0.1:6379/0
# celery -A executions.queue.celery_app worker -l info

# 运行环境隔离：dev / staging / prod（请求头 X-Environment 可覆盖）
ENVIRONMENT=dev

# 对外 URL 口径（Nginx/网关反代时务必按对外地址配置）
# PUBLIC_BASE_URL：集成商访问平台的对外 origin（含 http(s)://，不带路径）
#   开发：http://127.0.0.1:8000
#   生产：https://hub.example.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
# PUBLIC_API_PREFIX：API 对外暴露路径，与 Nginx location 口径一致（默认 /api；
# API 直接暴露在根域名时填 /）
# PUBLIC_API_PREFIX=/api
# SSO/OIDC 签发者，默认=PUBLIC_BASE_URL+PUBLIC_API_PREFIX，一般不用改
# SSO_ISSUER=
# 生产经 Nginx 反代时设 true，信任 X-Forwarded-* 还原真实 scheme/host
TRUST_PROXY_HEADERS=false
# Nginx 参考（注意 /api/ 尾斜杠两边要一致）：
#   location /api/ {
#       proxy_set_header Host $host;
#       proxy_set_header X-Forwarded-Host $host;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#       proxy_pass http://127.0.0.1:8000/api/;
#   }
# 部署后用 GET /api/open/status 核对 urls.apiBaseUrl 与 request.host/scheme

# OAuth2 授权码浏览器流程：未登录用户从 /api/oauth/authorize 跳到控制台登录页，
# 登录后控制台带 token 跳回 authorize 完成授权。
# 生产同源时默认 PUBLIC_BASE_URL + /login；开发态 Next.js 在另一端口需显式配置
# CONSOLE_LOGIN_URL=http://127.0.0.1:5004/login

# 集成商自助开户（沙箱 Key）。生产可关，或设邀请码。
OPEN_REGISTER_ENABLED=true
# OPEN_REGISTER_INVITE=
OPEN_SANDBOX_CALL_QUOTA=10000
OPEN_SANDBOX_ROW_QUOTA=100000
# NEXT_PUBLIC_ENVIRONMENT=dev

# === 商用部署 ===
# 部署模式：private（私有化）/ saas（多租户 SaaS）
#   private：License 门禁启用（Ed25519 离线签名）；配额超限放行 + 告警
#   saas：License 门禁跳过；配额超限硬拒绝（403/429）
DEPLOYMENT_MODE=private

# License 文件路径（私有化交付）。相对 PROJECT_ROOT，默认 license.json
#   用 scripts/generate_license.py gen-keys 生成密钥对、sign 签发给客户
#   校验失败只 warning，不阻断启动
LICENSE_FILE=license.json

# 日志级别 / 格式
#   LOG_LEVEL=INFO / DEBUG / WARNING / ERROR
#   格式：DEBUG=true 时 standard（人眼友好）；DEBUG=false 时 json（ELK/Loki 友好）
# LOG_LEVEL=INFO

# === 任务失败邮件告警（不配则只走 Webhook） ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
